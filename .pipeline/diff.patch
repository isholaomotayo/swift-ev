+  // an empty file that another contender could mistake for a corrupt lock.
+  const candidate = `${file}.${process.pid}.${crypto.randomUUID()}.candidate`;
+  fs.writeFileSync(candidate, body, { flag: 'wx', mode: 0o600 });
