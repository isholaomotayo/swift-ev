+export const RUNNER_BINS = {
+  claude: 'claude',
+  cursor: 'cursor-agent',
+  codex: 'codex',
+  antigravity: 'agy',
+  // Deprecated alias: Gemini CLI was replaced by Antigravity (`agy`).
+  gemini: 'agy',
