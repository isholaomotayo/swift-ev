+  git(root, 'init', '-q', '-b', 'main');
+  git(root, 'config', 'user.email', 'test@example.com');
+  git(root, 'config', 'user.name', 'Test');
+
+  fs.mkdirSync(path.join(root, '.pipeline', 'prompts'), { recursive: true });
