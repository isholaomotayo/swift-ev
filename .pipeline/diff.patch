+
+const ENGINE_DIR = path.dirname(fileURLToPath(import.meta.url));
+const REPO = path.dirname(ENGINE_DIR);
+
+function git(cwd, ...args) { return execFileSync('git', args, { cwd, encoding: 'utf8' }).trim(); }
+
