-+      // pending | running | passed | failed | blocked | skipped
-+      status: (name === 'designer' && !design) || (name === 'handoff' && !handoff) ? 'skipped' : 'pending',
-+      cycle: 0,
-+      maxCycles: name === 'coder' ? 5 : 1,
-+      startedAt: null,
-+      endedAt: null,
-+      artifact: null,
-+      detail: null,
