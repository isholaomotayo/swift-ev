-+    }
-+    case 'codex': {
-+      // codex exec supports a hard read-only sandbox.
-+      const args = ['exec'];
-+      if (readOnly) args.push('--sandbox', 'read-only');
-+      else args.push('--full-auto');
-+      args.push('--json');
-+      if (modelId) args.push('--model', modelId);
