+  // Run wall-clock, not the sum of stages: it also covers the orchestration
+  // time between them, which is what "how long has this taken" really means.
+  const total = fmtDur(state?.status?.startedAt, state?.status?.endedAt);
+  if (sum > 0 && total) {
+    totalEl.style.display = '';
