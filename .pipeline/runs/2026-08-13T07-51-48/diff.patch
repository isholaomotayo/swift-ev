+function renderRunBar() {
+  const el = document.getElementById('runbar');
+  if (!state?.status) { el.innerHTML = ''; return; }
+  const secs = ORDER.map((n) => stageSeconds(stageOf(n)));
+  const sum = secs.reduce((a, b) => a + b, 0);
+  el.innerHTML = ORDER.map((name, i) => {
+    const st = stageOf(name) || { status: 'pending' };
