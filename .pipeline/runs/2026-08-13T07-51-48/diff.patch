+
+  /* ===== MAIN ===== */
+  .main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
+
+  /* Agent header */
+  .agent-header {
+    padding: 12px 22px;
+    border-bottom: 1px solid var(--border);
+    flex-shrink: 0;
+    background: var(--surface-muted);
+  }
+  /* Inner wrapper keeps the header aligned with the centred reading column. */
+  .agent-header-inner {
+    display: flex; align-items: center; gap: 12px;
+    max-width: var(--content-w); margin: 0 auto; width: 100%;
+  }
+  .agent-header .agent-ico { width: 32px; height: 32px; }
+  .agent-header .agent-ico svg.ic { width: 15px; height: 15px; }
+  .agent-header .nm { font-weight: 700; font-size: 14px; line-height: 1.2; }
+  .agent-header .sub { font-size: 11.5px; color: var(--muted); margin-top: 1px; }
+  .agent-header .runtime-line { font-size: 11.5px; margin-top: 2px; color: var(--muted); }
+  .agent-header .runtime-line strong { font-weight: 700; color: var(--text); }
+  .agent-header .runtime-line .runner-strong { color: var(--purple-text); }
+  .agent-header .runtime-line .model-strong { color: var(--info-text); }
+  .agent-header .spacer { flex: 1; }
+  .model-badge {
+    font-size: 11.5px; font-weight: 700;
+    padding: 3px 10px; border-radius: 999px;
+    background: var(--info-bg); color: var(--info-text);
+    border: 1px solid var(--info-border);
+    white-space: nowrap;
+  }
+  .badge {
+    font-size: 11px; font-weight: 600;
+    padding: 3px 10px; border-radius: 999px;
+    display: inline-flex; align-items: center; gap: 5px;
+  }
+  .badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
+  .badge.running { background: var(--st-run-soft); color: var(--st-run-text); }
+  .badge.running::before { animation: pulse 1.2s infinite; }
+  .badge.passed  { background: var(--st-done-soft); color: var(--st-done-text); }
+  .badge.failed, .badge.blocked { background: var(--st-fail-soft); color: var(--st-fail-text); }
+  .badge.pending { background: var(--surface-hover); color: var(--muted); }
+  .badge.awaiting_host { background: var(--purple-bg); color: var(--purple-text); }
+  .badge.skipped {
+    background: none; color: var(--st-skip);
+    border: 1px dashed var(--st-skip); padding: 2px 9px;
+  }
+  .badge.skipped::before { background: none; border: 1px dashed currentColor; }
+
+  /* Banners */
+  #halt-banner {
