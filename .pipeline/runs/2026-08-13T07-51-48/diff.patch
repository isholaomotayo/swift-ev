+// One vocabulary for stage state, shared by the rail, the run bar, the dots and
+// the header badge — they used to each invent their own colour for "running".
+function stateClass(status) {
+  if (status === 'passed') return 'passed';
+  if (status === 'running') return 'running';
+  if (status === 'failed' || status === 'blocked') return 'failed';
+  if (status === 'skipped') return 'skipped';
+  return 'pending';
+}
+// When a stage's clock stops. A stage with no endedAt is only still counting if
+// the RUN is still going: a stage parked at a chat handoff has no end timestamp
