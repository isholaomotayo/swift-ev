+    const params = new URLSearchParams();
+    if (currentRun) params.set('run', currentRun);
+    if (currentProject) params.set('project', currentProject);
+    const qs = params.toString() ? '?' + params.toString() : '';
+    const r = await fetch('/api/state' + qs);
+    if (!r.ok) { currentRun = ''; document.getElementById('run-select').value = ''; return fetchState(); }
+    state = await r.json();
+    renderAll();
+    loadArtifacts();
+  } catch {}
+}
+async function fetchRuns() {
+  try {
+    const qs = currentProject ? '?project=' + encodeURIComponent(currentProject) : '';
+    runs = (await (await fetch('/api/runs' + qs)).json()).runs || [];
+    renderRunSelect();
+  } catch {}
+}
+
+document.getElementById('run-select').onchange = (e) => {
+  currentRun = e.target.value;
+  selected = null;
+  artifactCache = {};
+  fetchState();
+};
+
+// ---- follow-ups ----
+function updateFollowupButtons() {
+  const input = document.getElementById('followup-input');
+  const hasText = !!input.value.trim();
+  const canResume = !!state?.canResume;
+  const resumeBtn = document.getElementById('followup-resume');
+  if (canResume && hasText) {
+    resumeBtn.style.display = 'inline-flex';
+  } else {
+    resumeBtn.style.display = 'none';
+  }
+}
+
+async function sendFollowup() {
+  const input = document.getElementById('followup-input');
+  const text = input.value.trim();
+  if (!text || state?.live === false) return;
+  try {
+    const qs = currentProject ? '?project=' + encodeURIComponent(currentProject) : '';
+    await fetch('/api/followup' + qs, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ stage: activeAgent(), text }) });
+    input.value = '';
+    updateFollowupButtons();
+    fetchState();
+  } catch {}
+}
+
+async function sendResume() {
+  const btn = document.getElementById('resume-btn');
+  if (btn) { btn.disabled = true; btn.textContent = 'Resuming…'; }
+  try {
+    const qs = currentProject ? '?project=' + encodeURIComponent(currentProject) : '';
+    const r = await fetch('/api/resume' + qs, { method: 'POST' });
+    const out = await r.json();
+    if (out.error) { alert(out.error); if (btn) { btn.disabled = false; btn.textContent = 'Resume run'; } return; }
+    setTimeout(fetchState, 600);
+  } catch {
+    if (btn) { btn.disabled = false; btn.textContent = 'Resume run'; }
+  }
+}
+
+// Advance a run parked at a chat handoff or the plan-approval gate. Previously
+// the dashboard could only tell the user to go type a shell command.
+async function sendContinue({ approve, btn }) {
+  const label = btn.textContent;
+  btn.disabled = true; btn.textContent = approve ? 'Approving…' : 'Continuing…';
+  try {
+    const qs = currentProject ? '?project=' + encodeURIComponent(currentProject) : '';
+    const r = await fetch('/api/continue' + qs, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ approve: !!approve }),
+    });
+    const out = await r.json();
+    if (out.error) { alert(out.error); btn.disabled = false; btn.textContent = label; return; }
+    setTimeout(fetchState, 400);
+  } catch (err) {
+    alert(String(err));
+    btn.disabled = false; btn.textContent = label;
+  }
+}
+
+async function sendFollowupAndResume() {
+  const input = document.getElementById('followup-input');
+  const text = input.value.trim();
+  if (!text || state?.live === false || !state?.canResume) return;
+  const resumeBtn = document.getElementById('followup-resume');
+  const sendBtn = document.getElementById('followup-send');
+  if (resumeBtn) { resumeBtn.disabled = true; }
+  if (sendBtn) { sendBtn.disabled = true; }
+  try {
+    const qs = currentProject ? '?project=' + encodeURIComponent(currentProject) : '';
+    await fetch('/api/followup' + qs, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ stage: activeAgent(), text })
+    });
+    input.value = '';
+    updateFollowupButtons();
+    const r = await fetch('/api/resume' + qs, { method: 'POST' });
+    const out = await r.json();
+    if (out.error) { alert(out.error); }
+    setTimeout(fetchState, 600);
+  } catch (err) {
+    console.error(err);
+  } finally {
+    if (resumeBtn) { resumeBtn.disabled = false; }
+    if (sendBtn) { sendBtn.disabled = false; }
+  }
+}
+
+async function sendToOrchestrator() {
+  const input = document.getElementById('followup-input');
+  const text = input.value.trim();
+  if (!text || state?.live === false) return;
+  try {
+    const qs = currentProject ? '?project=' + encodeURIComponent(currentProject) : '';
+    const res = await fetch('/api/orchestrate' + qs, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ text })
+    });
+    const out = await res.json();
+    if (out.ok && out.stage) {
+      selected = out.stage;
+      input.value = '';
+      updateFollowupButtons();
+      await fetchState();
+      const q = document.getElementById('queued-pill');
+      if (q) {
+        q.style.display = '';
+        q.textContent = `routed to ${cap(out.stage)} · ${out.via}`;
+      }
+    } else {
+      alert(out.error || 'Failed to route message');
+    }
+  } catch (err) {
+    console.error(err);
+  }
+}
+
+document.getElementById('followup-send').onclick = sendFollowup;
+document.getElementById('orchestrate-send').onclick = sendToOrchestrator;
+document.getElementById('followup-resume').onclick = sendFollowupAndResume;
+document.getElementById('followup-input').addEventListener('input', updateFollowupButtons);
+document.getElementById('feed-filter').addEventListener('input', (e) => { feedFilter = e.target.value; applyFeedFilter(); });
+document.getElementById('followup-input').addEventListener('keydown', (e) => { if (e.key === 'Enter') sendFollowup(); });
+
+// ---- run controls ----
+const overlay = document.getElementById('newrun-overlay');
+function toggleManualModels() {
+  const manual = document.querySelector('input[name="nr-model-profile"]:checked')?.value === 'manual';
+  document.getElementById('nr-manual-models').classList.toggle('open', manual);
+}
+document.querySelectorAll('input[name="nr-model-profile"]').forEach((el) => {
+  el.addEventListener('change', toggleManualModels);
+});
+const MODEL_STAGES = ['planner', 'designer', 'coder', 'tester', 'reviewer', 'handoff'];
+const CUSTOM_MODEL_VALUE = '__custom__';
+
+function catalogOptionsHtml(selectedId) {
+  const catalog = state?.defaults?.modelCatalog || {};
+  const groups = Object.entries(catalog).map(([provider, models]) => {
+    const opts = (models || []).map((m) => `<option value="${esc(m.id)}"${m.id === selectedId ? ' selected' : ''}>${esc(m.label)} (${esc(m.id)})</option>`).join('');
+    return `<optgroup label="${esc(provider)}">${opts}</optgroup>`;
+  }).join('');
+  const known = Object.values(catalog).flat().some((m) => m.id === selectedId);
+  const customSelected = !known && selectedId ? ' selected' : '';
+  return `${groups}<option value="${CUSTOM_MODEL_VALUE}"${customSelected}>Custom…</option>`;
+}
+function toggleCustomModel(stage) {
+  const sel = document.getElementById(`nr-model-${stage}`);
+  const custom = document.getElementById(`nr-model-${stage}-custom`);
+  custom.classList.toggle('open', sel.value === CUSTOM_MODEL_VALUE);
+}
+function fillModelPlaceholders(runner) {
+  const key = !runner || runner === 'auto' ? 'host' : runner;
+  const profiles = state?.defaults?.modelProfiles || {};
+  const prof = profiles[key] || profiles.host || {};
+  MODEL_STAGES.forEach((stage) => {
+    const sel = document.getElementById(`nr-model-${stage}`);
+    sel.innerHTML = catalogOptionsHtml(prof[stage]);
+    toggleCustomModel(stage);
+  });
+}
+
+document.getElementById('newrun-btn').onclick = () => {
+  const sel = document.getElementById('nr-runner');
+  sel.innerHTML = (state?.runners || ['auto', 'claude', 'cursor', 'codex', 'gemini']).map((r) => `<option value="${r}">${r}</option>`).join('');
+  sel.onchange = () => fillModelPlaceholders(sel.value);
+  MODEL_STAGES.forEach((stage) => {
+    document.getElementById(`nr-model-${stage}`).onchange = () => toggleCustomModel(stage);
+  });
+  document.querySelector('input[name="nr-model-profile"][value="auto"]').checked = true;
+  toggleManualModels();
+  fillModelPlaceholders(sel.value);
+  document.getElementById('nr-err').textContent = '';
+  document.getElementById('nr-max-cycles').placeholder = String(state?.defaults?.maxCoderCycles ?? 5);
+  document.getElementById('nr-max-post-cycles').placeholder = String(state?.defaults?.maxPostTesterCycles ?? 2);
+  document.getElementById('nr-max-review-cycles').placeholder = String(state?.defaults?.maxReviewCycles ?? 3);
+  overlay.classList.add('open');
+  document.getElementById('nr-task').focus();
+};
+
+// Both cancel buttons close the modal
+document.getElementById('nr-cancel').onclick = () => overlay.classList.remove('open');
+document.getElementById('nr-cancel-btn').onclick = () => overlay.classList.remove('open');
+overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('open'); });
+
+document.getElementById('nr-start').onclick = async () => {
+  const modelProfile = document.querySelector('input[name="nr-model-profile"]:checked')?.value || 'auto';
+  const body = {
+    task: document.getElementById('nr-task').value,
+    runner: document.getElementById('nr-runner').value,
+    sandbox: document.getElementById('nr-sandbox').checked,
+    design: document.getElementById('nr-design').checked,
+    handoff: document.getElementById('nr-handoff').checked,
+    approvePlan: document.getElementById('nr-approve-plan').checked,
+    maxReviewCycles: document.getElementById('nr-max-review-cycles').value || undefined,
+    maxCycles: document.getElementById('nr-max-cycles').value || undefined,
+    maxPostTesterCycles: document.getElementById('nr-max-post-cycles').value || undefined,
+    modelProfile,
+  };
+  if (modelProfile === 'manual') {
+    body.models = {};
+    for (const stage of MODEL_STAGES) {
+      const sel = document.getElementById(`nr-model-${stage}`);
+      body.models[stage] = sel.value === CUSTOM_MODEL_VALUE
+        ? document.getElementById(`nr-model-${stage}-custom`).value.trim()
+        : sel.value.trim();
+    }
+  }
+  try {
+    const qs = currentProject ? '?project=' + encodeURIComponent(currentProject) : '';
+    const r = await fetch('/api/run' + qs, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
+    const out = await r.json();
+    if (out.error) { document.getElementById('nr-err').textContent = out.error; return; }
+    overlay.classList.remove('open');
+    document.getElementById('nr-task').value = '';
+    document.getElementById('nr-max-cycles').value = '';
+    document.getElementById('nr-max-post-cycles').value = '';
+    document.getElementById('nr-max-review-cycles').value = '';
+    currentRun = '';
+    document.getElementById('run-select').value = '';
+    selected = null;
+    artifactCache = {};
+    setTimeout(() => { fetchState(); fetchRuns(); }, 600);
+  } catch { document.getElementById('nr-err').textContent = 'failed to reach server'; }
+};
+
+document.getElementById('cancel-btn').onclick = async () => {
+  if (!confirm('Stop the active pipeline run?')) return;
+  try {
+    const qs = currentProject ? '?project=' + encodeURIComponent(currentProject) : '';
+    await fetch('/api/cancel' + qs, { method: 'POST' });
+    setTimeout(fetchState, 400);
+  } catch {}
+};
+
+async function sendExtend() {
+  const input = document.getElementById('extend-n');
+  const n = parseInt(input.value, 10);
+  if (!n || n < 1) return;
+  const btn = document.getElementById('extend-btn');
+  btn.disabled = true; btn.textContent = 'Extending…';
+  try {
+    const qs = currentProject ? '?project=' + encodeURIComponent(currentProject) : '';
+    const r = await fetch('/api/extend' + qs, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ extend: n }) });
+    const out = await r.json();
+    if (out.error) { alert(out.error); btn.disabled = false; btn.textContent = 'Extend & continue'; return; }
+    setTimeout(fetchState, 600);
+  } catch { btn.disabled = false; btn.textContent = 'Extend & continue'; }
+}
+
+function connectSSE() {
+  const conn = document.getElementById('conn');
+  if (sseConnection) { try { sseConnection.close(); } catch {} }
+  const sseUrl = '/events' + (currentProject ? '?project=' + encodeURIComponent(currentProject) : '');
+  const es = new EventSource(sseUrl);
+  sseConnection = es;
+  es.onopen = () => { conn.textContent = '● live'; conn.className = 'on'; };
+  es.onerror = () => { conn.textContent = '● reconnecting…'; conn.className = ''; };
+  es.onmessage = (m) => {
+    try {
+      if (JSON.parse(m.data).type === 'change' && !currentRun) { fetchState(); fetchRuns(); }
+    } catch {}
+  };
+}
+
+async function fetchProjects() {
+  try {
+    const r = await fetch('/api/projects');
+    const data = await r.json();
+    const select = document.getElementById('project-select');
+    // currentProject is the truth, not the widget: a project registers only when
+    // it is first requested, so the initial fetch can complete before it exists
+    // in the list, leaving the picker naming a different project than the one on
+    // screen for the rest of the session.
+    const prevSelected = currentProject || select.value;
+    select.innerHTML = '';
+    const list = data.projects || [];
+    if (list.length === 0) {
+      const opt = document.createElement('option');
+      opt.value = ''; opt.textContent = 'No projects registered';
+      select.appendChild(opt);
+      return;
+    }
+    list.forEach(p => {
+      const opt = document.createElement('option');
+      opt.value = p.repoRoot;
+      opt.textContent = `${p.name} (${p.overall})`;
+      if (p.repoRoot === prevSelected) opt.selected = true;
+      select.appendChild(opt);
+    });
+    if (!currentProject && list.length > 0) {
+      currentProject = list[0].repoRoot;
+      const newUrl = new URL(window.location);
+      newUrl.searchParams.set('project', currentProject);
+      window.history.replaceState({}, '', newUrl);
+    }
+  } catch (err) {
+    console.error('Failed to fetch projects', err);
+  }
+}
+
+async function initProject() {
+  currentRun = '';
+  selected = null;
+  artifactCache = {};
+  document.getElementById('run-select').value = '';
+  await fetchState();
+  await fetchRuns();
+  connectSSE();
+}
+
+async function startApp() {
+  await fetchProjects();
+  await initProject();
+  document.getElementById('project-select').onchange = (e) => {
+    currentProject = e.target.value;
+    const newUrl = new URL(window.location);
+    newUrl.searchParams.set('project', currentProject);
+    window.history.pushState({}, '', newUrl);
+    initProject();
+  };
+  setInterval(fetchProjects, 10000);
+}
+
+// ---- sidebar resize ----
+// Width lives on documentElement as --sidebar-w, so the topbar brand zone
+// (min-width: var(--sidebar-w)) stays aligned for free.
+(function initSidebarResize() {
+  const MIN = 240, MAX = 420;
+  const handle = document.getElementById('resize-handle');
+  const sidebar = document.querySelector('.sidebar');
+  const apply = (w) => document.documentElement.style.setProperty('--sidebar-w', w + 'px');
+  let dragging = false;
+
+  handle.addEventListener('pointerdown', (e) => {
+    dragging = true;
+    handle.classList.add('dragging');
+    document.body.classList.add('resizing');
+    e.preventDefault();
+  });
+  // Tracked on window, not on the handle: the pointer routinely leaves a 5px
+  // strip mid-drag, and relying on pointer capture alone would drop those moves.
+  window.addEventListener('pointermove', (e) => {
+    if (!dragging) return;
+    const left = sidebar.getBoundingClientRect().left;
+    apply(Math.round(Math.min(MAX, Math.max(MIN, e.clientX - left))));
+  });
+  const end = () => {
+    if (!dragging) return;
+    dragging = false;
+    handle.classList.remove('dragging');
+    document.body.classList.remove('resizing');
+    const w = parseInt(document.documentElement.style.getPropertyValue('--sidebar-w'), 10);
+    if (w) localStorage.setItem('orchestrator-sidebar-w', String(w));
+  };
+  window.addEventListener('pointerup', end);
+  window.addEventListener('pointercancel', end);
+  // Double-click resets: drop the inline override and fall back to :root.
+  handle.addEventListener('dblclick', () => {
+    document.documentElement.style.removeProperty('--sidebar-w');
+    localStorage.removeItem('orchestrator-sidebar-w');
+  });
+})();
+
+startApp();
+setInterval(() => { if (!currentRun) fetchState(); }, 3000);
+</script>
+</body>
+</html>
diff --git a/pipeline/handoff.mjs b/pipeline/handoff.mjs
new file mode 100644
index 0000000..1011c26
--- /dev/null
+++ b/pipeline/handoff.mjs
@@ -0,0 +1,92 @@
+// Deterministic handoff-document compiler. On any halt the orchestrator writes
+// .pipeline/handoff.md from run state alone — no LLM call — so the next session
+// (human or agent) can resume without archaeology, even when the halt cause is
+// the agent CLI itself. compileHaltHandoff is pure so it can be unit-tested
+// without running a pipeline.
+import fs from 'node:fs';
+import { spawnSync } from 'node:child_process';
+
+const RESUME_HINTS = {
+  MAX_CYCLES: 'Extend the same fix loop: `node pipeline/orchestrator.mjs --resume --extend <n>` (or the dashboard "Extend" button).',
+  REGRESSION_BLOCKED: 'A change broke previously passing tests. Inspect the diff and `.pipeline/checker_report.md` BEFORE any resume — regression halts are intentionally not extendable.',
+  MISSING_ARTIFACT: 'A stage exited without producing its artifact. Inspect that stage\'s log under `.pipeline/logs/`, then start a fresh run (or `node pipeline/orchestrator.mjs --resume` if the run is stale/interrupted).',
+  AGENT_ERROR: 'The agent CLI failed. Check authentication and the stage log under `.pipeline/logs/`, then `node pipeline/orchestrator.mjs --resume`.',
+  INTEGRITY_VIOLATION: 'A stage wrote pipeline control-plane files it does not own, or a read-only stage mutated the working tree. Its output is untrusted: review the listed files and `git status` BEFORE resuming, and prefer a runner that hard-enforces read-only (claude, codex) for audit stages.',
+  INVALID_VERDICT: 'The reviewer produced a report with no parseable verdict line. Read `.pipeline/review_report.md`; if the audit is sound, add "## Verdict: APPROVED|REQUEST_CHANGES|BLOCK" and `node pipeline/orchestrator.mjs --resume`.',
+  INTERRUPTED: 'The run was interrupted. Resume it: `node pipeline/orchestrator.mjs --resume`.',
+};
+
+export function collectGitInfo(cwd) {
+  const git = (args) => spawnSync('git', args, { cwd, encoding: 'utf8' });
+  if (git(['rev-parse', '--is-inside-work-tree']).status !== 0) return null;
+  const branch = (git(['rev-parse', '--abbrev-ref', 'HEAD']).stdout || '').trim() || null;
+  const dirty = (git(['status', '--porcelain']).stdout || '').trim().length > 0;
+  return { branch, dirty };
+}
+
+export function compileHaltHandoff({ status, history = null, git = null }) {
+  const reason = status.haltReason || 'UNKNOWN';
+  const halted = Boolean(status.haltReason);
+  const phase = status.haltedPhase || status.resumePoint?.step || '(unknown)';
+  const failing = (status.stages || []).find((s) => s.status === 'failed' || s.status === 'blocked' || s.status === 'interrupted');
+  const lines = [
+    halted ? '# Pipeline Handoff (auto-generated on halt)' : '# Pipeline Handoff (auto-generated)',
+    '',
+    '> **CRITICAL RESUME DIRECTION:** Do not start planning from scratch. Read `.pipeline/status.json` for the machine state, skim the artifacts below, then follow the resume command at the end.',
+    '',
+    halted ? '## 1. Summary of Blocked State' : '## 1. Summary of Final State',
+    `- **Goal:** ${status.task || '(unknown)'}`,
+    halted
+      ? `- **Outcome:** halted — ${reason}`
+      : `- **Outcome:** completed — verdict ${status.verdict || 'UNKNOWN'} (handoff agent failed; deterministic summary written instead)`,
+    `- **Phase at freeze:** ${phase}`,
+  ];
+  if (failing?.detail) lines.push(`- **Detail:** ${failing.detail}`);
+  lines.push('', '## 2. Stage Status', '| Stage | Status | Cycle | Artifact |', '|---|---|---|---|');
+  for (const s of status.stages || []) {
+    lines.push(`| ${s.name} | ${s.status} | ${s.cycle || 0}${s.maxCycles > 1 ? `/${s.maxCycles}` : ''} | ${s.artifact || '—'} |`);
+  }
+  lines.push('', '## 3. Verification Trend');
+  const runs = [...(history?.coder || []), ...(history?.postTester || [])];
+  if (runs.length) {
+    const last = runs[runs.length - 1];
+    lines.push(`- Last checker run: ${last.passedCount} passed / ${last.failedCount} failed (${last.isPassed ? 'GREEN' : 'RED'})`);
+    lines.push(`- Trend (passed counts): ${runs.map((r) => r.passedCount).join(' → ')}`);
+  } else {
+    lines.push('- No checker runs recorded for this run.');
+  }
+  lines.push('', '## 4. Artifacts to Read (in order)');
+  for (const [p, why] of [
+    ['`.pipeline/checker_report.md`', 'latest verification failures'],
+    ['`.pipeline/changes.md`', 'what the Coder implemented, fix cycle by fix cycle'],
+    ['`.pipeline/specs.md`', 'the specification being implemented'],
+    ['`.pipeline/design.md`', 'finalized design contracts (if the design stage ran)'],
+    ['`.pipeline/review_report.md`', 'last review verdict (if the reviewer ran)'],
+    ['`.pipeline/logs/`', 'raw per-stage agent logs'],
+  ]) lines.push(`- ${p} — ${why}`);
+  lines.push('', '## 5. Git State');
+  if (git) {
+    lines.push(`- Branch: ${git.branch || '(detached)'}`);
+    lines.push(`- Base commit for this run: ${status.baseRef || '(none captured)'}`);
+    lines.push(`- Working tree: ${git.dirty ? 'DIRTY (uncommitted changes present)' : 'clean'}`);
+  } else {
+    lines.push('- Not a git repository (or git unavailable).');
+  }
+  lines.push('', '## 6. How to Resume');
+  if (halted) {
+    lines.push(`- ${RESUME_HINTS[reason] || 'Inspect `.pipeline/status.json` and the stage logs, then `node pipeline/orchestrator.mjs --resume`.'}`);
+    lines.push('- Chat mode: `bash .pipeline/orchestrate.sh --continue` when a stage handoff is pending.', '');
+  } else {
+    lines.push('- The run completed — no resume needed. Read `.pipeline/review_report.md` for the verdict and follow-ups, and `.pipeline/status.json` for final state.', '');
+  }
+  return lines.join('\n');
+}
+
+export function writeHaltHandoff({ paths, status, history = null, cwd = paths.root }) {
+  try {
+    fs.writeFileSync(paths.handoffDoc, compileHaltHandoff({ status, history, git: collectGitInfo(cwd) }));
+    return true;
+  } catch {
+    return false; // best-effort; never mask the original halt
+  }
+}
