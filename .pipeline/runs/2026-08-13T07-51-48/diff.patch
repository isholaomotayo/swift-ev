+  applyFeedFilter();
+  if (atBottom) wrap.scrollTop = wrap.scrollHeight;
+}
+
+let feedFilter = '';
+
+// A long coder loop produces hundreds of blocks; finding the one command or file
+// you care about meant scrolling. Filtering is done over rendered blocks so it
+// costs nothing until it is used.
+function applyFeedFilter() {
+  const feed = document.getElementById('feed');
+  const q = feedFilter.trim().toLowerCase();
+  const blocks = feed.querySelectorAll('.feed-block');
+  if (!q) {
+    blocks.forEach((b) => { b.style.display = ''; });
+    return;
+  }
+  let shown = 0;
+  blocks.forEach((b) => {
+    const hit = b.textContent.toLowerCase().includes(q);
+    b.style.display = hit ? '' : 'none';
+    if (hit) shown++;
+  });
+  let note = feed.querySelector('.filter-note');
+  if (!note) {
+    note = document.createElement('div');
+    note.className = 'empty-feed filter-note';
+    feed.appendChild(note);
+  }
+  note.style.display = shown ? 'none' : '';
+  note.textContent = `No activity matches "${feedFilter}".`;
+}
+
+
+
+function selectionInside(el) {
+  const sel = window.getSelection();
+  if (!sel || sel.isCollapsed || sel.rangeCount === 0) return false;
+  return el.contains(sel.getRangeAt(0).commonAncestorContainer);
+}
+
+async function loadArtifacts() {
+  const name = activeAgent();
+  for (const file of AGENTS[name].artifacts) {
+    if (!(state?.artifacts || []).includes(file)) continue;
+    try {
+      const params = new URLSearchParams();
+      if (currentRun) params.set('run', currentRun);
+      if (currentProject) params.set('project', currentProject);
+      params.set('name', file);
+      const r = await fetch('/api/artifact?' + params.toString());
+      artifactCache[file] = (await r.json()).content;
+    } catch {}
+  }
+  renderFeed();
+}
+
+function renderRunSelect() {
+  const sel = document.getElementById('run-select');
