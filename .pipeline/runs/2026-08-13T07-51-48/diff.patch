+    const row = document.createElement('button');
+    row.type = 'button';
+    row.className = `rail-row is-${cls}` + (cur === name ? ' selected' : '');
+    if (running === name) row.setAttribute('aria-current', 'step');
+    row.title = s
+      ? `${cap(name)} — ${fmtDur(st.startedAt, stageEnd(st))} · ${share}% of run`
+      : `${cap(name)} — ${cls === 'skipped' ? 'skipped (stage not enabled)' : 'not started'}`;
+    row.innerHTML = `<span class="rail-accent"></span>${agentIco(name)}` +
+      `<span class="rail-main">` +
+        `<span class="rail-top">` +
+          `<span class="rail-nm">${cap(name)}</span>` +
+          `<span class="sdot ${esc(st.status)}"></span>` +
+          `<span class="rail-dur">${esc(dur)}</span>` +
+        `</span>` +
+        `<span class="rail-sub">${esc(railSubText(name, st))}</span>` +
+        `<span class="rail-track"><span class="rail-bar" style="width:${pct}%"></span></span>` +
+      `</span>`;
