+    --orange: #f97316; --code-bg: #1c1917; --accent-row: #3b2f1f;
+    --info-bg: #1e3a5f; --info-text: #93c5fd; --info-border: #1e40af;
+    --halt-border: #7f1d1d; --halt-input-border: #991b1b;
+    --pre-bg: #1c1917; --inline-code-bg: #3f3a36;
+    --diff-bg: #292524; --diff-add-bg: #14532d; --diff-add-text: #86efac;
+    --diff-del-bg: #450a0a; --diff-del-text: #fca5a5;
+    --diff-hunk-bg: #2e1065; --diff-hunk-text: #c4b5fd;
+    --syntax-kw: #c4b5fd; --syntax-str: #fdba74; --syntax-cmt: #78716c; --syntax-typ: #67e8f9;
+    --terminal-bg: #0c0a09; --terminal-text: #e7e5e4; --terminal-muted: #78716c;
+    --overlay: rgba(0, 0, 0, .55); --shadow: rgba(0, 0, 0, .45);
+    --shadow-sm: rgba(0, 0, 0, .2);
+    --agent-planner-bg: #2e1065; --agent-planner-fg: #c4b5fd;
+    --agent-designer-bg: #172554; --agent-designer-fg: #93c5fd;
+    --agent-coder-bg: #1e3a5f; --agent-coder-fg: #93c5fd;
+    --agent-tester-bg: #14532d; --agent-tester-fg: #86efac;
+    --agent-reviewer-bg: #451a03; --agent-reviewer-fg: #fcd34d;
+    --agent-handoff-bg: #064e3b; --agent-handoff-fg: #6ee7b7;
+    --st-done: #22c55e; --st-done-soft: #14532d; --st-done-text: #86efac;
+    --st-run: #3b82f6;  --st-run-soft: #1e3a5f;  --st-run-text: #93c5fd;
+    --st-pending: #57534e; --st-pending-text: #78716c;
+    --st-skip: #57534e;
+    --st-fail: #ef4444; --st-fail-soft: #450a0a; --st-fail-text: #fca5a5;
+    --track: #332e2b;
+    --focus: #60a5fa;
+  }
+  html { color-scheme: light dark; }
+  html[data-theme="light"] { color-scheme: light; }
+  html[data-theme="dark"] { color-scheme: dark; }
+  * { box-sizing: border-box; }
+  html, body { height: 100%; }
+  body { margin: 0; background: var(--bg); color: var(--text); font: 13px/1.5 ui-sans-serif, -apple-system, "Segoe UI", system-ui, sans-serif; }
+  svg.ic { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
+  /* Several controls clear the UA outline for looks; put a deliberate one back
+     for keyboard users. */
+  :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
+  body.resizing { user-select: none; cursor: col-resize; }
+
+  /* ===== APP SHELL ===== */
+  .app { display: flex; flex-direction: column; height: 100vh; max-width: 1440px; margin: 0 auto; background: var(--panel); border-left: 1px solid var(--border); border-right: 1px solid var(--border); }
+
+  /* ===== MENUBAR (slim top bar) ===== */
+  .topbar {
+    display: flex;
+    align-items: center;
+    padding: 0 14px 0 0;
+    border-bottom: 1px solid var(--border);
+    flex-shrink: 0;
+    height: 40px;
+    gap: 0;
+  }
+
+  /* Brand zone — aligns with sidebar width */
+  .topbar-brand {
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    padding: 0 16px;
+    height: 100%;
+    flex-shrink: 0;
+    min-width: var(--sidebar-w);
+    border-right: 1px solid var(--border);
+  }
+  .appicon {
+    width: 24px; height: 24px; border-radius: 7px;
+    background: var(--inverse); color: var(--on-inverse);
+    display: grid; place-items: center; flex-shrink: 0;
+  }
+  .appicon svg.ic { width: 12px; height: 12px; }
+  .brand-name { font-weight: 700; font-size: 12.5px; color: var(--text); letter-spacing: -.01em; white-space: nowrap; }
+
+  /* Center — runtime context + status */
+  .topbar-center {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    padding: 0 14px;
+    flex: 1;
+    min-width: 0;
+    height: 100%;
+    overflow: hidden;
+  }
+  .topbar-center .spacer { flex: 1; min-width: 0; }
+  .totals { font-size: 11px; color: var(--muted); white-space: nowrap; flex-shrink: 0; }
+
+  /* Runtime chips — shown when a run is active */
+  .runtime-strip { display: none; align-items: center; gap: 6px; flex-shrink: 0; }
+  .runtime-strip.visible { display: inline-flex; }
+  .runtime-sep { width: 1px; height: 12px; background: var(--border); }
+  .runtime-chip {
+    display: inline-flex; align-items: center; gap: 4px;
+    font-size: 11px; color: var(--muted); white-space: nowrap;
+  }
+  .runtime-chip .lbl { font-size: 9px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--faint); }
+  .runtime-chip strong { font-size: 11.5px; font-weight: 700; color: var(--text); letter-spacing: -.01em; }
+  .runtime-chip.runner strong { color: var(--purple-text); }
+  .runtime-chip.model strong { color: var(--info-text); }
+
+  /* Status pill */
+  .pill {
+    font-size: 10.5px; font-weight: 500;
+    padding: 2px 8px; border-radius: 999px;
+    background: var(--surface-hover); color: var(--muted);
+    border: 1px solid var(--border);
+    white-space: nowrap; flex-shrink: 0;
+    display: inline-flex; align-items: center; gap: 4px;
+  }
+  .pill::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; opacity: .5; }
+  .pill.active { background: var(--st-done-soft); color: var(--st-done-text); border-color: transparent; }
+  .pill.active::before { opacity: 1; animation: pulse 1.4s infinite; }
+  .pill.halted { background: var(--st-fail-soft); color: var(--st-fail-text); border-color: transparent; }
+  .pill.stale { background: var(--amber-bg); color: var(--amber-text); border-color: transparent; }
+  .pill.awaiting { background: var(--purple-bg); color: var(--purple-text); border-color: transparent; }
+  .pill.update { background: var(--st-run-soft); color: var(--st-run-text); border-color: transparent; cursor: help; }
+  .pill.update::before { opacity: 1; }
+  .pill[hidden] { display: none; }
+
+  /* Scaffold/engine notice under the project picker */
+  .side-note {
+    display: flex; align-items: flex-start; gap: 6px;
+    margin-top: 7px; padding: 0 2px;
+    font-size: 10.5px; line-height: 1.45; color: var(--muted);
+  }
+  .side-note::before {
+    content: ''; flex-shrink: 0;
+    width: 5px; height: 5px; margin-top: 5px; border-radius: 50%;
+    background: var(--st-run);
+  }
+  .side-note[hidden] { display: none; }
+
+  /* Menubar right — theme toggle only */
+  .topbar-end {
+    display: flex;
+    align-items: center;
+    gap: 4px;
+    padding: 0 0 0 10px;
+    height: 100%;
+    flex-shrink: 0;
+  }
+
+  /* Shared button base */
+  .tb-btn {
+    display: inline-flex; align-items: center; gap: 5px;
+    font: 500 11.5px inherit;
+    border: 1px solid var(--border);
+    background: var(--surface);
+    color: var(--text);
+    border-radius: 7px;
+    padding: 4px 9px;
+    cursor: pointer;
+    white-space: nowrap;
+    height: 28px;
+    transition: background .1s, border-color .1s;
+  }
+  .tb-btn:hover { background: var(--surface-muted); }
+  .tb-btn svg.ic { opacity: .7; }
+  .tb-btn.primary {
+    background: var(--inverse); border-color: var(--inverse);
+    color: var(--on-inverse); font-weight: 600;
+  }
+  .tb-btn.primary svg.ic { opacity: 1; }
+  .tb-btn.primary:hover { opacity: .88; }
+  .tb-btn.danger {
+    background: var(--red-bg); border-color: transparent;
+    color: var(--red-text);
+  }
+  #theme-btn { padding: 4px 7px; }
+
+  /* ===== SIDEBAR CONTROL PANEL ===== */
+  /* Fixed header inside sidebar — project picker + run controls */
+  /* ===== BODY LAYOUT ===== */
+  .body { display: flex; flex: 1; min-height: 0; }
+
+  /* ===== SIDEBAR ===== */
+  .sidebar {
+    width: var(--sidebar-w);
+    flex-shrink: 0;
+    background: var(--sidebar);
+    border-right: 1px solid var(--border);
+    display: flex;
+    flex-direction: column;
+    overflow: hidden;
+    position: relative;
+  }
+  .sidebar-scroll { flex: 1; overflow-y: auto; padding: 10px 14px 8px; }
+
+  /* Drag-to-resize handle — a comfortable 10px hit area straddling the
+     sidebar's right border, with a thin 2px visual affordance on hover. */
+  .resize-handle {
+    position: absolute; top: 0; right: -5px; bottom: 0;
+    width: 10px; cursor: col-resize; z-index: 5;
+    background: transparent;
+  }
+  .resize-handle::after {
+    content: ''; position: absolute; top: 0; bottom: 0; left: 4px;
+    width: 2px; background: var(--st-run); opacity: 0;
+    transition: opacity .12s;
+  }
+  .resize-handle:hover::after, .resize-handle.dragging::after { opacity: .6; }
+
+  /* Section headings — visible, structured labels */
+  .side-section { margin-bottom: 14px; }
+  .side-section:last-child { margin-bottom: 4px; }
+  .side-heading {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    font-size: 10px; font-weight: 700; letter-spacing: .08em;
+    color: var(--faint); text-transform: uppercase;
+    padding: 0 2px 8px;
+  }
+  .side-heading::after {
+    content: '';
+    flex: 1;
+    height: 1px;
+    background: var(--border);
+  }
+
+  /* Project selector row — inside sidebar scroll */
+  .project-row {
+    display: flex;
+    align-items: center;
+    gap: 0;
+    background: var(--surface-muted);
+    border: 1px solid var(--border);
+    border-radius: 9px;
+    height: 34px;
+    overflow: hidden;
+  }
+  .project-row:focus-within { border-color: var(--neutral); }
+  .project-row .proj-icon {
+    display: grid; place-items: center;
+    width: 32px; height: 32px; flex-shrink: 0;
+    color: var(--faint);
+  }
+  .project-row .proj-icon svg.ic { width: 12px; height: 12px; }
+  #project-select {
+    font: 600 12px inherit;
+    color: var(--text);
+    border: none;
+    background: transparent;
+    padding: 0 8px 0 0;
+    outline: none;
+    cursor: pointer;
+    flex: 1;
+    min-width: 0;
+  }
+
+  /* ===== SIDEBAR FOOTER (run controls) ===== */
+  /* Pinned at the bottom of the sidebar, aligned with the main composer */
+  .sidebar-footer {
+    flex-shrink: 0;
+    border-top: 1px solid var(--border);
+    background: var(--sidebar);
+    padding: 12px 14px 14px;
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+  }
+  .sidebar-footer .sf-heading {
+    font-size: 10px; font-weight: 700; letter-spacing: .08em;
+    color: var(--faint); text-transform: uppercase;
+  }
+  /* Run history dropdown — full width */
+  #run-select {
+    width: 100%;
+    font: 11px inherit;
+    color: var(--muted);
+    border: 1px solid var(--border);
+    border-radius: 7px;
+    background: var(--surface-muted);
+    padding: 5px 7px;
+    outline: none;
+    cursor: pointer;
+  }
+  #run-select:hover { border-color: var(--neutral); }
+  /* Action buttons row */
+  .run-controls {
+    display: flex;
+    align-items: center;
+    gap: 5px;
+  }
+  /* Sidebar action buttons */
+  .side-btn {
+    display: inline-flex; align-items: center; gap: 4px;
+    font: 500 11px inherit;
+    border: 1px solid var(--border);
+    background: var(--surface);
+    color: var(--text);
+    border-radius: 7px;
+    padding: 5px 9px;
+    cursor: pointer;
+    white-space: nowrap;
+    height: 28px;
+    flex-shrink: 0;
+    transition: background .1s;
+  }
+  .side-btn:hover { background: var(--surface-hover); }
+  .side-btn svg.ic { width: 12px; height: 12px; opacity: .7; }
+  .side-btn.primary {
+    flex: 1;
+    justify-content: center;
+    background: var(--inverse); border-color: var(--inverse);
+    color: var(--on-inverse); font-weight: 600;
+  }
+  .side-btn.primary svg.ic { opacity: 1; }
+  .side-btn.primary:hover { opacity: .88; }
+  .side-btn.danger {
+    background: var(--red-bg); border-color: transparent; color: var(--red-text);
+  }
+
+  /* ===== PIPELINE RAIL =====
+     One row per stage: identity, state, and share of wall-clock in a single
+     place. Replaces the old agent list + stepper + timings trio, which showed
+     the same six stages three times over. */
+  .rail { display: flex; flex-direction: column; gap: 2px; }
+  .rail-row {
+    position: relative;
+    display: flex; align-items: flex-start; gap: 10px;
+    width: 100%; text-align: left;
+    padding: 8px 10px 9px;
+    border: 1px solid transparent; border-radius: 9px;
+    background: transparent; color: inherit; font: inherit;
+    cursor: pointer;
+    transition: background .14s, border-color .14s;
+  }
+  .rail-row:hover { background: var(--surface-hover); }
+  .rail-row.selected { background: var(--accent-row); border-color: var(--border); }
+  .rail-accent {
+    position: absolute; left: 0; top: 10px; bottom: 10px;
+    width: 3px; border-radius: 0 3px 3px 0;
+    background: transparent; transition: background .2s;
+  }
+  .rail-row .agent-ico { margin-top: 1px; }
+  .rail-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
+  .rail-top { display: flex; align-items: center; gap: 7px; }
+  .rail-nm { font-weight: 600; font-size: 12.5px; line-height: 1.3; flex: 1; min-width: 0; }
+  .rail-dur {
+    font-size: 10.5px; color: var(--faint); flex-shrink: 0;
+    font-variant-numeric: tabular-nums; transition: color .2s;
+  }
+  .rail-sub {
+    font-size: 10.5px; color: var(--muted); line-height: 1.35;
+    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+  }
+  /* The bar is a block element on purpose: as an inline span (what this used
+     to be) width/height simply do not apply and the track renders empty. */
+  .rail-track {
+    display: block; height: 4px; margin-top: 3px;
+    background: var(--track); border-radius: 999px; overflow: hidden;
+  }
+  .rail-bar {
+    display: block; height: 100%; width: 0;
+    border-radius: 999px; background-color: var(--st-pending);
+    transition: width .45s cubic-bezier(.4, 0, .2, 1), background-color .2s;
+  }
+  .rail-row.is-passed  .rail-bar { background-color: var(--st-done); }
+  .rail-row.is-passed  .rail-dur { color: var(--st-done-text); }
+  .rail-row.is-running .rail-accent { background: var(--st-run); }
+  .rail-row.is-running .rail-bar {
+    background-color: var(--st-run);
+    background-image: linear-gradient(90deg, transparent, rgba(255, 255, 255, .5), transparent);
+    background-size: 50% 100%; background-repeat: no-repeat;
+    animation: shimmer 1.6s linear infinite;
+  }
+  .rail-row.is-running .rail-dur { color: var(--st-run-text); font-weight: 700; }
+  .rail-row.is-failed  .rail-bar { background-color: var(--st-fail); }
+  .rail-row.is-failed  .rail-dur { color: var(--st-fail-text); font-weight: 700; }
+  .rail-row.is-skipped { opacity: .55; }
+  /* Dimming must not swallow the selection cue when a skipped stage is opened. */
+  .rail-row.is-skipped.selected, .rail-row.is-skipped:hover { opacity: .85; }
+  .rail-row.is-skipped .rail-track {
+    height: 2px; margin-top: 4px; border-radius: 0; background: none;
+    background-image: repeating-linear-gradient(90deg, var(--st-skip) 0 4px, transparent 4px 8px);
+  }
+  @keyframes shimmer { 0% { background-position: -60% 0; } 100% { background-position: 160% 0; } }
+
+  /* Run total — closes the rail so the per-stage bars have a denominator */
+  .rail-total {
+    display: flex; align-items: center; justify-content: space-between;
+    margin-top: 8px; padding: 8px 10px 0;
+    border-top: 1px solid var(--border);
+    font-size: 10.5px; color: var(--faint);
+  }
+  .rail-total b { color: var(--text); font-weight: 700; font-variant-numeric: tabular-nums; }
+
+  /* Segmented run bar — at-a-glance progress, segment widths driven by real
+     stage durations rather than arbitrary equal columns. */
+  .runbar { display: flex; gap: 2px; margin-top: 10px; }
+  .runbar-seg {
+    height: 6px; min-width: 0; flex-basis: 0; flex-shrink: 1;
+    border-radius: 999px;
+    background: var(--track);
+    transition: flex-grow .45s cubic-bezier(.4, 0, .2, 1), background-color .25s;
+  }
+  .runbar-seg.is-passed  { background: var(--st-done); }
+  .runbar-seg.is-running { background: var(--st-run); animation: pulse 1.4s infinite; }
+  .runbar-seg.is-failed  { background: var(--st-fail); }
+  .runbar-seg.is-skipped {
+    background: none; opacity: .5;
+    background-image: repeating-linear-gradient(90deg, var(--st-skip) 0 3px, transparent 3px 6px);
+  }
+
+  .agent-ico {
+    width: 28px; height: 28px; border-radius: 8px;
+    display: grid; place-items: center; flex-shrink: 0;
+  }
+  .agent-ico.planner { background: var(--agent-planner-bg); color: var(--agent-planner-fg); }
+  .agent-ico.designer { background: var(--agent-designer-bg); color: var(--agent-designer-fg); }
+  .agent-ico.coder   { background: var(--agent-coder-bg); color: var(--agent-coder-fg); }
+  .agent-ico.tester  { background: var(--agent-tester-bg); color: var(--agent-tester-fg); }
+  .agent-ico.reviewer{ background: var(--agent-reviewer-bg); color: var(--agent-reviewer-fg); }
+  .agent-ico.handoff  { background: var(--agent-handoff-bg); color: var(--agent-handoff-fg); }
+  .agent-ico svg.ic { width: 14px; height: 14px; }
+  .sdot { width: 7px; height: 7px; border-radius: 50%; background: var(--st-pending); flex-shrink: 0; transition: background .2s; }
+  .sdot.running { background: var(--st-run); animation: pulse 1.2s infinite; }
+  .sdot.passed  { background: var(--st-done); }
+  .sdot.failed, .sdot.blocked { background: var(--st-fail); }
+  .sdot.skipped { background: var(--st-skip); opacity: .45; }
+  @keyframes pulse { 50% { opacity: .35; } }
+
+  /* Task box */
+  .task-box { padding: 0 2px; }
+  .task-box .task-text {
+    font-size: 12.5px; line-height: 1.55;
+    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
+  }
