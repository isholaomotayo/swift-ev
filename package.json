{
  "name": "swift-ev",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "concurrently --names \"NEXT,CONVEX\" --prefix-colors \"cyan,magenta\" \"next dev --turbopack\" \"convex dev\"",
    "dev:next": "next dev --turbopack --port 3001",
    "dev:convex": "convex dev",
    "build": "pnpm paraglide:compile && next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "test": "bun test",
    "test:predeploy": "bun run scripts/run-predeployment-tests.ts",
    "test:coverage:report": "bun run scripts/generate-prepush-coverage-report.ts",
    "test:e2e": "bun test --timeout 30000 tests/registration-e2e.test.ts",
    "test:auth": "bun test --timeout 30000 tests/registration-e2e.test.ts tests/auth.test.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale",
    "extract:strings": "tsx scripts/extract-strings.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^1.41.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "convex": "^1.45.0",
    "date-fns": "^3.0.6",
    "dompurify": "^3.3.3",
    "jose": "^5.1.3",
    "lucide-react": "^0.303.0",
    "next": "16.1.1",
    "next-cloudinary": "^5.18.0",
    "numeral": "^2.0.6",
    "paystack": "^2.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.49.3",
    "react-resizable-panels": "^4.7.3",
    "svix": "^1.88.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.12.0",
    "@inlang/plugin-m-function-matcher": "^2.2.1",
    "@inlang/plugin-message-format": "^4.3.0",
    "@inlang/sdk": "^2.7.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20",
    "@types/numeral": "^2.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/typescript-estree": "^8.56.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.56",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.10",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "unplugin": "^3.0.0"
  }
}